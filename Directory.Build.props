<Project>

  <PropertyGroup Label="Target frameworks">
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <NetLoaderTargetFramework>net10.0</NetLoaderTargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework Condition="$(MSBuildProjectName.Contains('NetLoader'))">$(NetLoaderTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">$(DefaultTargetFramework)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Hot reload and Edit and Continue compare the version metadata of every referenced assembly
       with the copy already loaded in the process, and refuse to apply changes when the two differ
       (CS7038, or ENC0003 for the attribute itself). MinVer derives the version from git tags and is
       skipped by design-time builds - the very builds hot reload compiles against - so the version
       it produces and the SDK default the design-time path falls back to would disagree. Debug
       builds therefore keep a constant version and MinVer is left to version Release and CI only. -->
  <PropertyGroup Label="Versioning" Condition="'$(Configuration)' == 'Debug'">
    <MinVerSkip>true</MinVerSkip>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>anchur</Authors>
    <Company>anchur</Company>
    <Copyright>Half Life 1 SDK Copyright(c) Valve Corp.</Copyright>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/anchurcn/GoldsrcFramework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/anchurcn/GoldsrcFramework/releases</PackageReleaseNotes>
    <PackageTags>goldsrc;half-life;modding;dotnet;csharp</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/anchurcn/GoldsrcFramework.git</RepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Build tools" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" Version="8.0.0" />
    <PackageReference Include="MinVer" PrivateAssets="all" Version="6.0.0" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

</Project>
